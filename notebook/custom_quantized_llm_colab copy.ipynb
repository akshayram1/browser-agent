      "source": [
        "# Custom Quantized LLM for OmniBrowser Agent\n",
        "\n",
        "This notebook fine-tunes a small planner model in Colab (QLoRA), runs a sanity check on merged output, then quantizes to MLC format for WebLLM (q4f16_1).\n",
        "\n",
        "Expected dataset format (JSONL):\n",
        "- messages[0]: system prompt\n",
        "- messages[1]: user message (prompt.ts style)\n",
        "- messages[2]: assistant JSON string with {evaluation, memory, nextGoal, action}"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "id": "4ba23b59",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "ldconfig done\n",
            "Patched triton_based_modules (8 stubs)\n",
            "Setup complete.\n"
          ]
        }
      ],
      "source": [
        "# ── Step 1: Downgrade PyTorch from cu130 to cu128 ─────────────────────────────\n",
        "# Colab ships torch 2.11.0+cu130 but the CUDA 13.0 runtime libs (libnvJitLink\n",
        "# .so.13 etc.) are NOT available on the VM. Reinstalling with cu128 index gives\n",
        "# us torch built against CUDA 12.8 which matches what Colab actually has.\n",
        "# Source: https://stackoverflow.com/a/79914657\n",
        "!pip install -q -U \\\n",
        "  \"torch==2.11.0\" \\\n",
        "  \"torchvision==0.26.0\" \\\n",
        "  \"torchaudio==2.11.0\" \\\n",
        "  --index-url https://download.pytorch.org/whl/cu128\n",
        "\n",
        "# ── Step 2: Install training stack ────────────────────────────────────────────\n",
        "!pip install -q -U \\\n",
        "  \"transformers==4.46.3\" \\\n",
        "  \"trl==0.11.4\" \\\n",
        "  \"peft==0.13.2\" \\\n",
        "  \"accelerate==1.1.1\" \\\n",
        "  \"datasets==3.1.0\" \\\n",
        "  \"bitsandbytes\"\n",
        "\n",
        "# ── Step 3: Make libnvJitLink visible to the dynamic linker ───────────────────\n",
        "!for f in /usr/local/lib/python3.*/dist-packages/nvidia/nvjitlink/lib/libnvJitLink*; do \\\n",
        "    ln -sf \"$f\" /usr/local/lib/$(basename \"$f\"); \\\n",
        "  done 2>/dev/null; ldconfig 2>/dev/null; echo \"ldconfig done\"\n",
        "\n",
        "# ── Step 4: Patch bitsandbytes triton modules for Colab ───────────────────────\n",
        "import importlib.util, os, re, sys\n",
        "from pathlib import Path\n",
        "\n",
        "def _patch_bnb_triton():\n",
        "    try:\n",
        "        import triton.ops.matmul_perf_model  # noqa\n",
        "        return\n",
        "    except (ImportError, ModuleNotFoundError):\n",
        "        pass\n",
        "\n",
        "    spec = importlib.util.find_spec(\"bitsandbytes\")\n",
        "    if spec is None:\n",
        "        return\n",
        "\n",
        "    bnb_dir = Path(spec.origin).parent\n",
        "    nn_init = bnb_dir / \"nn\" / \"__init__.py\"\n",
        "    tm = bnb_dir / \"nn\" / \"triton_based_modules.py\"\n",
        "    if tm.exists():\n",
        "        needed = set()\n",
        "        if nn_init.exists():\n",
        "            init_src = nn_init.read_text(encoding=\"utf-8\")\n",
        "            needed.update(re.findall(r\"from\\s+\\.triton_based_modules\\s+import[^)]+?(\\w+)\", init_src))\n",
        "            block = re.search(r\"from\\s+\\.triton_based_modules\\s+import\\s*\\((.*?)\\)\", init_src, re.DOTALL)\n",
        "            if block:\n",
        "                needed.update(re.findall(r\"\\b(\\w+)\\b\", block.group(1)))\n",
        "        original = tm.read_text(encoding=\"utf-8\")\n",
        "        needed.update(re.findall(r\"^class\\s+(\\w+)\", original, re.MULTILINE))\n",
        "        if not needed:\n",
        "            needed = {\"StandardLinear\", \"SwitchBackLinear\", \"SwitchBackLinearBnb\",\n",
        "                       \"SwitchBackLinearGlobal\", \"SwitchBackLinearVectorwise\"}\n",
        "        names = sorted(needed)\n",
        "        stub = \"import torch.nn as nn\\n\\n\"\n",
        "        stub += \"\".join(f\"class {n}(nn.Linear): pass\\n\" for n in names)\n",
        "        tm.write_text(stub, encoding=\"utf-8\")\n",
        "        print(f\"Patched triton_based_modules ({len(names)} stubs)\")\n",
        "\n",
        "    for rel in [\"triton/int8_matmul_mixed_dequantize.py\",\n",
        "                \"triton/int8_matmul_rowwise_dequantize.py\",\n",
        "                \"triton/dequantize_rowwise.py\"]:\n",
        "        p = bnb_dir / rel\n",
        "        if p.exists():\n",
        "            p.write_text(\"def stub(*a, **k): return None\\n\", encoding=\"utf-8\")\n",
        "\n",
        "    stale = [k for k in sys.modules if \"bitsandbytes\" in k]\n",
        "    for k in stale:\n",
        "        del sys.modules[k]\n",
        "\n",
        "_patch_bnb_triton()\n",
        "print(\"Setup complete.\")"
      ]
    },
