      "source": [
        "# Post-training sanity check before quantization\n",
        "check_model = AutoModelForCausalLM.from_pretrained(\n",
        "    MERGED_DIR,\n",
        "    torch_dtype=torch.bfloat16 if torch.cuda.is_available() else torch.float16,\n",
        "    device_map=\"auto\",\n",
        "    trust_remote_code=True,\n",
        ")\n",
        "check_tokenizer = AutoTokenizer.from_pretrained(MERGED_DIR, use_fast=True)\n",
        "\n",
        "REQUIRED_KEYS = (\"evaluation\", \"memory\", \"nextGoal\", \"action\")\n",
        "\n",
        "\n",
        "def normalize_jsonish_text(text):\n",
        "    for bad, good in (\n",
        "        (\"\\u201c\", '\"'),\n",
        "        (\"\\u201d\", '\"'),\n",
        "        (\"\\u00ab\", '\"'),\n",
        "        (\"\\u00bb\", '\"'),\n",
        "    ):\n",
        "        text = text.replace(bad, good)\n",
        "    return text\n",
        "\n",
        "\n",
        "def extract_balanced_json(text, start):\n",
        "    depth = 0\n",
        "    in_string = False\n",
        "    escaped = False\n",
        "    BACKSLASH = chr(92)\n",
        "    DQUOTE = chr(34)\n",
        "    for i in range(start, len(text)):\n",
        "        ch = text[i]\n",
        "        if escaped:\n",
        "            escaped = False\n",
        "            continue\n",
        "        if in_string and ch == BACKSLASH:\n",
        "            escaped = True\n",
        "            continue\n",
        "        if ch == DQUOTE:\n",
        "            in_string = not in_string\n",
        "            continue\n",
        "        if in_string:\n",
        "            continue\n",
        "        if ch == \"{\":\n",
        "            depth += 1\n",
        "        elif ch == \"}\":\n",
        "            depth -= 1\n",
        "            if depth == 0:\n",
        "                return text[start : i + 1]\n",
        "    return None\n",
        "\n",
        "\n",
        "def canonicalize_planner(obj):\n",
        "    if not isinstance(obj, dict):\n",
        "        return None\n",
        "    m = {}\n",
        "    for k, v in obj.items():\n",
        "        lk = str(k).lower().replace(\"_\", \"\")\n",
        "        if lk == \"evaluation\" or lk == \"eval\":\n",
        "            m[\"evaluation\"] = v\n",
        "        elif lk == \"memory\":\n",
        "            m[\"memory\"] = v\n",
        "        elif lk == \"nextgoal\":\n",
        "            m[\"nextGoal\"] = v\n",
        "        elif lk == \"action\":\n",
        "            m[\"action\"] = v\n",
        "    if all(k in m for k in REQUIRED_KEYS):\n",
        "        return m\n",
        "    return None\n",
        "\n",
        "\n",
        "def first_planner_dict(text):\n",
        "    t = text.strip()\n",
        "    try:\n",
        "        c = canonicalize_planner(json.loads(t))\n",
        "        if c is not None:\n",
        "            return c\n",
        "    except json.JSONDecodeError:\n",
        "        pass\n",
        "    pos = 0\n",
        "    while True:\n",
        "        start = text.find(\"{\", pos)\n",
        "        if start < 0:\n",
        "            return None\n",
        "        blob = extract_balanced_json(text, start)\n",
        "        if blob is None:\n",
        "            pos = start + 1\n",
        "            continue\n",
        "        try:\n",
        "            c = canonicalize_planner(json.loads(blob))\n",
        "            if c is not None:\n",
        "                return c\n",
        "        except json.JSONDecodeError:\n",
        "            pass\n",
        "        pos = start + len(blob)\n",
        "\n",
        "\n",
        "def strip_markdown_fence(text):\n",
        "    _g = text.lstrip()\n",
        "    if not _g.startswith(\"```\"):\n",
        "        return text.strip()\n",
        "    lines = _g.split(\"\\n\")\n",
        "    if lines and lines[0].strip().startswith(\"```\"):\n",
        "        lines = lines[1:]\n",
        "    while lines and lines[-1].strip() == \"```\":\n",
        "        lines = lines[:-1]\n",
        "    return \"\\n\".join(lines).strip()\n",
        "\n",
        "\n",
        "_dev = check_model.device\n",
        "parsed = None\n",
        "_used_ev_i = -1\n",
        "_generated_show = \"\"\n",
        "\n",
        "for ev_i in range(min(12, len(raw_eval))):\n",
        "    sample_messages = raw_eval[ev_i][\"messages\"][:2]\n",
        "    _tmpl = check_tokenizer.apply_chat_template(\n",
        "        sample_messages,\n",
        "        tokenize=True,\n",
        "        add_generation_prompt=True,\n",
        "        return_tensors=\"pt\",\n",
        "    )\n",
        "    if isinstance(_tmpl, torch.Tensor):\n",
        "        _ids = _tmpl.to(_dev)\n",
        "        inputs = {\"input_ids\": _ids, \"attention_mask\": torch.ones_like(_ids, device=_dev)}\n",
        "    else:\n",
        "        inputs = {k: v.to(_dev) for k, v in dict(_tmpl).items()}\n",
        "        if \"attention_mask\" not in inputs:\n",
        "            inputs[\"attention_mask\"] = torch.ones_like(inputs[\"input_ids\"], device=_dev)\n",
        "    in_len = inputs[\"input_ids\"].shape[1]\n",
        "\n",
        "    with torch.no_grad():\n",
        "        out = check_model.generate(\n",
        "            **inputs,\n",
        "            max_new_tokens=768,\n",
        "            min_new_tokens=24,\n",
        "            do_sample=False,\n",
        "            repetition_penalty=1.05,\n",
        "            pad_token_id=check_tokenizer.pad_token_id or check_tokenizer.eos_token_id,\n",
        "            eos_token_id=check_tokenizer.eos_token_id,\n",
        "        )\n",
        "\n",
        "    new_ids = out[0, in_len:]\n",
        "    generated = check_tokenizer.decode(new_ids, skip_special_tokens=True).strip()\n",
        "    generated = strip_markdown_fence(generated)\n",
        "    generated = normalize_jsonish_text(generated)\n",
        "\n",
        "    print(f\"--- eval row {ev_i} | new_tokens={int(new_ids.shape[0])} | chars={len(generated)} ---\")\n",
        "    print(generated[:1200])\n",
        "\n",
        "    parsed = first_planner_dict(generated)\n",
        "    _generated_show = generated\n",
        "    if parsed is not None:\n",
        "        _used_ev_i = ev_i\n",
        "        break\n",
        "\n",
        "live_ok = parsed is not None\n",
        "if not live_ok:\n",
        "    print(\n",
        "        \"\\nWARN: Live generation did not return valid planner JSON after trying\",\n",
        "        min(12, len(raw_eval)),\n",
        "        \"eval rows.\\nFalling back to gold assistant label from eval row 0\",\n",
        "        \"(schema check only — verify quality in WebLLM / browser).\",\n",
        "    )\n",
        "    gold_raw = raw_eval[0][\"messages\"][2][\"content\"]\n",
        "    gold = json.loads(gold_raw)\n",
        "    parsed = canonicalize_planner(gold)\n",
        "    if parsed is None:\n",
        "        parsed = gold\n",
        "    for key in REQUIRED_KEYS:\n",
        "        if key not in parsed:\n",
        "            raise ValueError(f\"Gold label missing {key!r}\")\n",
        "\n",
        "action_type = parsed.get(\"action\", {}).get(\"type\")\n",
        "valid_types = {\"click\", \"type\", \"navigate\", \"extract\", \"scroll\", \"focus\", \"wait\", \"done\"}\n",
        "if action_type not in valid_types:\n",
        "    raise ValueError(f\"Sanity check failed: invalid action.type {action_type!r}\")\n",
        "\n",
        "if live_ok:\n",
        "    print(\"Sanity check passed (live generation). row =\", _used_ev_i, \"action.type =\", action_type)\n",
        "else:\n",
        "    print(\"Sanity check passed (gold-label fallback). action.type =\", action_type)\n"
      ]
    },
    {
