        "# ── Get dataset onto the cloud VM ────────────────────────────────────────────\n",
        "# google.colab.files.upload() only works in the Colab browser UI and hangs/fails\n",
        "# when the kernel is accessed from Cursor, VS Code, or any remote client.\n",
        "#\n",
        "# The dataset is committed to the public GitHub repo, so we wget it directly.\n",
        "# No browser interaction needed — works identically in all clients.\n",
        "\n",
        "import subprocess\n",
        "\n",
        "GITHUB_RAW  = \"https://raw.githubusercontent.com/akshayram1/omnibrowser-agent/main\"\n",
        "DATASET_URL = f\"{GITHUB_RAW}/notebook/data/omnibrowser_planner_train.jsonl\"\n",
        "\n",
        "# Check both existence AND non-zero size — a previous failed upload/wget can\n",
        "# leave a 0-byte file behind, which must be re-downloaded.\n",
        "needs_download = (\n",
        "    not os.path.exists(DATASET_PATH)\n",
        "    or os.path.getsize(DATASET_PATH) == 0\n",
        ")\n",
        "\n",
        "if not needs_download:\n",
        "    with open(DATASET_PATH) as f:\n",
        "        n = sum(1 for _ in f)\n",
        "    if n == 0:\n",
        "        needs_download = True  # file exists but is empty (e.g. bad HTML response)\n",
        "        print(\"File exists but is empty — re-downloading.\")\n",
        "\n",
        "if needs_download:\n",
        "    print(\"Downloading dataset from GitHub...\")\n",
        "    r = subprocess.run(\n",
        "        [\"wget\", \"-q\", DATASET_URL, \"-O\", DATASET_PATH],\n",
        "        capture_output=True, text=True,\n",
        "    )\n",
        "    if r.returncode != 0:\n",
        "        print(\"stderr:\", r.stderr[:500])\n",
        "        raise RuntimeError(\n",
        "            f\"wget failed (exit {r.returncode}). \"\n",
        "            \"Make sure the GitHub repo is public and the URL is correct:\\n\"\n",
        "            f\"  {DATASET_URL}\"\n",
        "        )\n",
        "\n",
        "    # Verify we got real JSONL, not a GitHub 404 HTML page\n",
        "    with open(DATASET_PATH) as f:\n",
        "        first_line = f.readline().strip()\n",
        "    if not first_line.startswith(\"{\"):\n",
        "        os.remove(DATASET_PATH)\n",
        "        raise RuntimeError(\n",
        "            f\"Downloaded file does not look like JSONL (got: {first_line[:120]!r}).\\n\"\n",
        "            \"Check that the GitHub repo and branch are public.\"\n",
        "        )\n",
        "    print(\"Downloaded to\", DATASET_PATH)\n",
        "\n",
        "with open(DATASET_PATH) as f:\n",
        "    n = sum(1 for _ in f)\n",
        "print(f\"Dataset ready: {n} examples\")"
      ]
    },
