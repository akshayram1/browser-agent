      "source": [
        "# Hugging Face login (only needed when PUSH_TO_HF=True).\n",
        "# Reads HF_TOKEN from .env first, then falls back to interactive login.\n",
        "\n",
        "def load_env_value(key, env_paths):\n",
        "    for env_path in env_paths:\n",
        "        if not os.path.exists(env_path):\n",
        "            continue\n",
        "        with open(env_path, \"r\", encoding=\"utf-8\") as f:\n",
        "            for raw_line in f:\n",
        "                line = raw_line.strip()\n",
        "                if not line or line.startswith(\"#\") or \"=\" not in line:\n",
        "                    continue\n",
        "                k, v = line.split(\"=\", 1)\n",
        "                if k.strip() != key:\n",
        "                    continue\n",
        "                val = v.strip().strip('\"').strip(\"'\")\n",
        "                if val:\n",
        "                    return val, env_path\n",
        "    return None, None\n",
        "\n",
        "if PUSH_TO_HF:\n",
        "    env_candidates = [\n",
        "        \"/Users/akshaychame/omnibrowser-agent/notebook/.env\",  # local dev path\n",
        "        \"./notebook/.env\",                                      # repo-relative path\n",
        "        \"/content/notebook/.env\",                               # Colab repo copy path\n",
        "    ]\n",
        "\n",
        "    hf_token, token_source = load_env_value(\"HF_TOKEN\", env_candidates)\n",
        "\n",
        "    if hf_token:\n",
        "        hf_login(token=hf_token, add_to_git_credential=False)\n",
        "        print(f\"HF login succeeded using token from: {token_source}\")\n",
        "    else:\n",
        "        print(\"HF_TOKEN not found in .env; opening notebook_login() prompt.\")\n",
        "        notebook_login()\n",
        "else:\n",
        "    print(\"Skipping HF login because PUSH_TO_HF=False\")\n"
      ]
    },
